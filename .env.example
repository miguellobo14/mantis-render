# Copia este archivo a .env y rellena las claves.

# Claude API (https://platform.claude.com) — escribe el prompt del render a partir del brief y la imagen.
ANTHROPIC_API_KEY=

# fal.ai (https://fal.ai/dashboard/keys) — genera el render.
FAL_KEY=

# Opcionales
# CLAUDE_MODEL=claude-opus-5-5
# FAL_MODEL=fal-ai/flux-pro/kontext
# RENDER_MAX_TRIES=3
